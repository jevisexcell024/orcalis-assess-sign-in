# ================================================================
# Orcalis Assess — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ================================================================

# ── Supabase ──────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Server-side only (not exposed to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Application ──────────────────────────────────────────────────
VITE_APP_URL=http://localhost:5173
VITE_APP_NAME="Orcalis Assess"
VITE_APP_VERSION=1.0.0

# ── Sentry (optional — error tracking) ───────────────────────────
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ── Feature Flags (JSON format) ──────────────────────────────────
VITE_FEATURE_FLAGS={"enableAdvancedAnalytics":false,"enableGDPRCompliance":true,"enableNewProctoringEngine":false}

# ── Email (SMTP via Supabase or custom) ──────────────────────────
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@yourdomain.com
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@youruni.edu

# ── Cloudflare (production deployment) ───────────────────────────
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# ── AI / OpenAI (AI question generation, grading) ────────────────
OPENAI_API_KEY=sk-your-openai-api-key

# ── Payment Gateway (Stripe / Paystack) ──────────────────────────
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret

# ── SMS / WhatsApp (Twilio) ───────────────────────────────────────
TWILIO_ACCOUNT_SID=ACyour-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=+14155238886

# ── Google OAuth ─────────────────────────────────────────────────
# See docs/GOOGLE_OAUTH.md for setup instructions
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Resend (transactional email for Cloudflare Workers) ──────────
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key

# ── Stripe ────────────────────────────────────────────────────────
# Webhook secret: stripe listen --print-secret
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# Internal API key for webhook endpoints
INTERNAL_API_KEY=
