# ============================================================
# Orcalis Assess — Environment Variables Template
# ------------------------------------------------------------
# 1. Copy this file to `.env`
# 2. Fill in the values below
# 3. NEVER commit `.env` — it is in `.gitignore`
# ============================================================

# --- Supabase (public; safe to expose to the browser) ---
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key-here"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# Server-side mirror (used by SSR + email webhook)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-key-here"

# --- Supabase (SERVER-ONLY, NEVER expose to browser) ---
# Used by admin server functions only. If this leaks, your DB is open to the world.
# Rotate immediately if you suspect exposure: Supabase Dashboard > Settings > API > Reset.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Admin allow-list (comma-separated emails) ---
VITE_ADMIN_EMAILS="admin@example.com"

# --- Sentry error tracking (optional but recommended) ---
VITE_SENTRY_DSN=""

# --- Lovable email service (server-side only) ---
LOVABLE_API_KEY=""

# --- Cloudflare deployment ---
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""

# --- Cloudflare Turnstile (CAPTCHA) — added in next feature batch ---
# VITE_TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""

# --- Feature flags (JSON object) ---
VITE_FEATURE_FLAGS='{"enableGDPRCompliance": true}'
